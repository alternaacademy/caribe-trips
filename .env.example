MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=caribe_trips
API_BIND=0.0.0.0:8080
WEB_ORIGIN=http://localhost:5173

# Host port docker-compose publishes MongoDB on. Override if 27017 is taken
# by a local Mongo (then update MONGODB_URI to match, e.g. ...localhost:27018).
MONGO_PORT=27017

# ── AI concierge (Ollama) ────────────────────────────────────────────────
# Use the tailnet FQDN, not the short host name: containers resolve through
# Docker's resolver, which has no tailnet search domain.
OLLAMA_URL=http://gauss.icefish-vector.ts.net:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_MS=60000
# Set to false to turn the concierge off without a redeploy.
CONCIERGE_ENABLED=true
